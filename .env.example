# =============================================================================
# Nextcloud AIO + Cloudflare Tunnel — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# Get this from: Cloudflare Zero Trust > Networks > Tunnels > Create tunnel
# Copy the token shown in the connector installation step.
# -----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Nextcloud Data Directory
# IMPORTANT: Set this BEFORE the first run. Changing it afterward will break
# your installation. Make sure the path has enough free space.
# -----------------------------------------------------------------------------
NEXTCLOUD_DATADIR=/opt/nextcloud/data

# -----------------------------------------------------------------------------
# Resource Limits (optional — defaults shown)
# -----------------------------------------------------------------------------
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M

# -----------------------------------------------------------------------------
# S3 Backup (for syncing AIO's local Borg backups offsite)
# AIO creates local Borg backup archives; this script syncs them to S3.
# Configure the Borg backup directory in the AIO interface first.
# -----------------------------------------------------------------------------

# Path on the HOST where you will point AIO's backup (set in AIO interface)
BORG_BACKUP_DIR=/opt/nextcloud/borg-backup

# AWS / S3-compatible credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region where your bucket lives
S3_REGION=

# S3 bucket name
S3_BUCKET=

# Prefix / "folder" inside the bucket
S3_BACKUP_PREFIX=nextcloud-borg

# For non-AWS S3-compatible storage (Cloudflare R2, Backblaze B2, MinIO, etc.)
# Leave blank for standard AWS S3
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
