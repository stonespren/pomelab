# =============================================================================
# Copy to .env, fill in the "Required" section, then run: sudo ./setup.sh
# Blanks in the last section are filled in by setup.sh.
# Quote any value that contains spaces, e.g. SERVER_COUNTRIES="United States".
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# A domain whose DNS is on Cloudflare, exactly as it appears there, e.g. example.com.
# Apps are published as cloud.<DOMAIN>, jellyfin.<DOMAIN> and so on.
DOMAIN=

# Cloudflare API token with these permissions, scoped to your account and DOMAIN:
#   Account > Cloudflare Tunnel > Edit
#   Account > Access: Apps and Policies > Edit
#   Zone > Zone > Read
#   Zone > DNS > Edit
# setup.sh uses it to create the tunnel and its routes, DNS records and
# Cloudflare Access apps, and checks them again on every run.
CLOUDFLARE_API_TOKEN=

# The only email allowed through Cloudflare Access to the admin apps (Sonarr,
# Radarr, Prowlarr, qBittorrent) and to SSH at ssh.<DOMAIN>. Only used when an
# Access app is created: to
# change it later, edit the apps under Zero Trust > Access > Applications, or
# delete them and re-run setup.sh.
ACCESS_EMAIL=

# S3-compatible bucket for offsite copies of Nextcloud's backups. The key needs
# read, write, delete and list on the bucket.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AWS: the bucket's region. Cloudflare R2: auto. Backblaze B2: e.g. us-west-004.
S3_REGION=
# Blank for AWS. Otherwise, e.g.:
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:  https://s3.<region>.backblazeb2.com
S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# VPN for qBittorrent (gluetun). qBittorrent and Decluttarr stay stopped until
# VPN_SERVICE_PROVIDER is set.
# Provider guides: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# -----------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard

# For VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# For VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional server location, e.g. Netherlands
SERVER_COUNTRIES=
SERVER_CITIES=

# "on" gets a forwarded port automatically, which helps seeding. Supported by
# Private Internet Access, ProtonVPN, Perfect Privacy and PrivateVPN.
VPN_PORT_FORWARDING=off

# For a fixed forwarded port from another provider, list it here and set
# QBITTORRENT_TORRENT_PORT to the same number.
FIREWALL_VPN_INPUT_PORTS=
# qBittorrent's peer port inside the VPN. Nothing is opened on the server or router.
QBITTORRENT_TORRENT_PORT=6881

# -----------------------------------------------------------------------------
# Storage. Set these before the first run: moving them later means moving data.
# -----------------------------------------------------------------------------

# Nextcloud user files. Can't be changed once Nextcloud is installed.
NEXTCLOUD_DATADIR=/opt/nextcloud/data
# AIO's encrypted Borg backups, which are copied to S3 daily.
BORG_BACKUP_DIR=/opt/nextcloud/borg-backup
# Prefix inside the bucket for those copies.
S3_PREFIX=nextcloud-borg

# Media and downloads. Must be one filesystem so imports can use hardlinks.
# Point it at your largest disk.
MEDIA_DATA_DIR=/opt/media/data
# App configuration and databases. Fast storage helps.
MEDIA_CONFIG_DIR=/opt/media/config

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Nextcloud limits
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M

# Address the app ports listen on. 127.0.0.1 keeps them reachable only through
# the tunnel or SSH. A LAN address lets devices at home skip Cloudflare, but
# Docker's published ports bypass ufw and similar firewalls.
MEDIA_BIND_IP=127.0.0.1

# Decluttarr only logs what it would remove until this is false.
DECLUTTARR_TEST_RUN=true

# -----------------------------------------------------------------------------
# Filled in by setup.sh. Set any of these yourself before the first run to
# override them.
# -----------------------------------------------------------------------------

# Name of the Cloudflare tunnel setup.sh creates or reuses. Defaults to the
# server's hostname, so two servers never share a tunnel by accident.
TUNNEL_NAME=
CLOUDFLARE_TUNNEL_TOKEN=

# Owner of media files, and timezone. Default to the user running sudo and the
# server's timezone.
PUID=
PGID=
TZ=

# Login shared by all the media apps. Blank password generates a random one.
# Letters and numbers only: it is also passed to Decluttarr inside quoted YAML.
# After the first run, change passwords in each app rather than here, except
# that Decluttarr reads qBittorrent's password from this value.
MEDIA_ADMIN_USER=admin
MEDIA_ADMIN_PASSWORD=

SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# "vpn" once VPN_SERVICE_PROVIDER is set.
COMPOSE_PROFILES=
