# =============================================================================
# Nextcloud AIO + Cloudflare Tunnel — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# Get this from: Cloudflare Zero Trust > Networks > Tunnels > Create tunnel
# Copy the token shown in the connector installation step.
# -----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Nextcloud Data Directory
# IMPORTANT: Set this BEFORE the first run. Changing it afterward will break
# your installation. Make sure the path has enough free space.
# -----------------------------------------------------------------------------
NEXTCLOUD_DATADIR=/opt/nextcloud/data

# -----------------------------------------------------------------------------
# Resource Limits (optional — defaults shown)
# -----------------------------------------------------------------------------
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M

# -----------------------------------------------------------------------------
# S3 Backup (for syncing AIO's local Borg backups offsite)
# AIO creates local Borg backup archives; this script syncs them to S3.
# Configure the Borg backup directory in the AIO interface first.
# -----------------------------------------------------------------------------

# Path on the HOST where you will point AIO's backup (set in AIO interface)
BORG_BACKUP_DIR=/opt/nextcloud/borg-backup

# AWS / S3-compatible credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region where your bucket lives
S3_REGION=

# S3 bucket name
S3_BUCKET=

# Prefix / "folder" inside the bucket
S3_BACKUP_PREFIX=nextcloud-borg

# For non-AWS S3-compatible storage (Cloudflare R2, Backblaze B2, MinIO, etc.)
# Leave blank for standard AWS S3
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Media Stack
# Anything left blank here is filled in by setup.sh.
# -----------------------------------------------------------------------------

# Media and downloads. Keep this on one filesystem so imports can use hardlinks.
# Point it at your largest disk.
MEDIA_DATA_DIR=/opt/media/data

# App configuration and databases. Fast storage helps here.
MEDIA_CONFIG_DIR=/opt/media/config

# Address the app ports listen on. 127.0.0.1 keeps them private, reachable only
# through an SSH tunnel or Cloudflare Tunnel. Docker's published ports bypass
# ufw and similar firewalls, so a LAN address or 0.0.0.0 exposes them directly.
MEDIA_BIND_IP=127.0.0.1

# Owner of media files and timezone. Blank uses the user running sudo and the
# server's timezone.
PUID=
PGID=
TZ=

# Login shared by all the apps. Blank password generates a random one.
# Letters and numbers only: this is also passed to Decluttarr inside quoted YAML.
# After first setup, change passwords in each app rather than here, except that
# Decluttarr reads qBittorrent's password from this value.
MEDIA_ADMIN_USER=admin
MEDIA_ADMIN_PASSWORD=

# Blank generates a key. Set before first setup.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# -----------------------------------------------------------------------------
# VPN for qBittorrent (Gluetun)
# qBittorrent and Decluttarr don't start until VPN_SERVICE_PROVIDER is set.
# Provider setup guides: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# -----------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard

# For VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# For VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional server location, e.g. Netherlands
SERVER_COUNTRIES=
SERVER_CITIES=

# "on" gets a forwarded port automatically, which helps seeding. Supported by
# Private Internet Access, ProtonVPN, Perfect Privacy and PrivateVPN.
VPN_PORT_FORWARDING=off

# For a fixed forwarded port from another provider, list it here and set
# QBITTORRENT_TORRENT_PORT to the same number.
FIREWALL_VPN_INPUT_PORTS=

# -----------------------------------------------------------------------------
# Public addresses: <app>.MEDIA_DOMAIN on your existing Cloudflare tunnel
# Setup only ever adds routes. Existing ones, including Nextcloud's, are untouched.
# Leave MEDIA_DOMAIN blank to keep all the apps private.
# -----------------------------------------------------------------------------

# Your domain as it appears in Cloudflare, e.g. example.com
MEDIA_DOMAIN=

# API token with: Account > Cloudflare Tunnel > Edit, Zone > DNS > Edit,
# Zone > Zone > Read, and Account > Access: Apps and Policies > Edit.
# Blank lists the routes in NEXT_STEPS.md for you to add by hand.
CLOUDFLARE_API_TOKEN=

# The only email allowed through Cloudflare Access to Sonarr, Radarr, Prowlarr and
# qBittorrent. Those four are not published until this is set.
MEDIA_ACCESS_EMAIL=

# Decluttarr only logs what it would remove until this is false.
DECLUTTARR_TEST_RUN=true

# Enabled by setup.sh when a VPN is configured. Leave this to setup.sh.
COMPOSE_PROFILES=

# Host ports
PROWLARR_PORT=8109
QBITTORRENT_PORT=8133
# qBittorrent's peer port inside the VPN. Nothing is opened on the server or router.
QBITTORRENT_TORRENT_PORT=6881
SONARR_PORT=8098
RADARR_PORT=8088
SEERR_PORT=5055
JELLYFIN_PORT=8091
AUDIOBOOKSHELF_PORT=13378
READMEABOOK_PORT=3030
